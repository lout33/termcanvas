{
  "name": "termcanvas",
  "productName": "TermCanvas",
  "version": "0.3.7",
  "private": true,
  "description": "Infinite canvas desktop app for arranging real terminal sessions and tmux-backed developer workflows.",
  "author": "lout",
  "license": "MIT",
  "homepage": "https://github.com/lout33/termcanvas",
  "bugs": {
    "url": "https://github.com/lout33/termcanvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lout33/termcanvas.git"
  },
  "keywords": [
    "terminal",
    "terminal-workspace",
    "spatial-terminal",
    "infinite-canvas",
    "tmux",
    "electron",
    "developer-tools",
    "developer-productivity",
    "ai-agents",
    "xterm"
  ],
  "main": "main.js",
  "scripts": {
    "postinstall": "python3 -c \"from pathlib import Path; [p.exists() and p.chmod(p.stat().st_mode | 0o111) for p in [Path('node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper'), Path('node_modules/node-pty/prebuilds/darwin-x64/spawn-helper')]]\"",
    "test": "node --test test/*.test.js",
    "build:markdown-editor": "esbuild renderer_workspace_markdown.mjs --bundle --format=iife --platform=browser --global-name=noteCanvasRendererWorkspaceMarkdown --outfile=renderer_workspace_markdown.bundle.js --minify",
    "build": "npm run build:markdown-editor && node --check main.js && node --check preload.js && node --check renderer.js",
    "dev": "npm run build && electron .",
    "dist:mac": "npm run build && npm test && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.3",
    "markdown-it": "^14.1.1",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^35.5.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0"
  }
}
